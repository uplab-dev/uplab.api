          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "// Фильтр строится по первому свойству из предыдущего запроса «Данные фильтра».",
              "const raw = pm.collectionVariables.get('filterBaseline');",
              "const body = { siteId: pm.variables.get('siteId') };",
              "pm.collectionVariables.unset('filterTargetCode');",
              "if (raw) {",
              "  const baseline = JSON.parse(raw);",
              "  const target = Object.keys(baseline).find(code => baseline[code].sampleValue !== null);",
              "  if (target) {",
              "    pm.collectionVariables.set('filterTargetCode', target);",
              "    body.filter = {};",
              "    body.filter['PROPERTY_' + target] = baseline[target].sampleValue;",
              "  }",
              "}",
              "pm.request.body.update({ mode: 'raw', raw: JSON.stringify(body) });"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test('Статус 200', () => pm.expect(pm.response.code).to.eql(200));",
              "const target = pm.collectionVariables.get('filterTargetCode');",
              "const baseline = JSON.parse(pm.collectionVariables.get('filterBaseline') || '{}');",
              "(target ? pm.test : pm.test.skip)('Переданный filter сужает значения других свойств', () => {",
              "  pm.response.json().forEach(prop => {",
              "    if (prop.code === target) { return; }",
              "    const base = baseline[prop.code];",
              "    if (!base) { return; }",
              "    pm.expect(prop.items.length, 'значения свойства ' + prop.code + ' не шире набора без фильтра').to.be.at.most(base.count);",
              "  });",
              "});",
              "(target ? pm.test : pm.test.skip)('Свойство из filter не сужает собственный список значений', () => {",
              "  const prop = pm.response.json().find(item => item.code === target);",
              "  pm.expect(prop, 'свойство ' + target + ' осталось в ответе').to.not.be.undefined;",
              "  pm.expect(prop.items.length).to.eql(baseline[target].count);",
              "});"
            ] } }
          ]
        },
