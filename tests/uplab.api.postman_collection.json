{
  "info": {
    "_postman_id": "9f3c2a10-1b2c-4d5e-8a90-uplabapi18000",
    "name": "uplab.api — REST API tests",
    "description": "Тестовая коллекция всех эндпоинтов модуля uplab.api.\n\nИмпортируется в Postman и в Insomnia (Insomnia: Import → выбрать этот файл — понимает формат Postman v2.1).\n\nПеред запуском заполните переменные коллекции (вкладка Variables): baseUrl, siteId и коды сущностей вашего проекта. Для мутирующих content-эндпоинтов нужен bitrixSessid.\n\nБазовые проверки (нет 5xx/фатала, тело — валидный JSON, нет утечки PHP-ошибки) выполняются для КАЖДОГО запроса на уровне коллекции. Отдельные проверки статуса/поведения — в конкретных запросах.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://example.ru", "type": "string" },
    { "key": "siteId", "value": "ru", "type": "string" },
    { "key": "iblockCode", "value": "catalog", "type": "string" },
    { "key": "elementCode", "value": "example-element", "type": "string" },
    { "key": "elementId", "value": "1", "type": "string" },
    { "key": "sectionCode", "value": "example-section", "type": "string" },
    { "key": "sectionId", "value": "1", "type": "string" },
    { "key": "hlblockCode", "value": "SomeHlblock", "type": "string" },
    { "key": "pageCode", "value": "about", "type": "string" },
    { "key": "formCode", "value": "FEEDBACK", "type": "string" },
    { "key": "contentPageCode", "value": "main", "type": "string" },
    { "key": "contentElementId", "value": "1", "type": "string" },
    { "key": "menuCode", "value": "top", "type": "string" },
    { "key": "searchQuery", "value": "test", "type": "string" },
    { "key": "bitrixSessid", "value": "", "type": "string" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Базовые проверки для каждого запроса коллекции.",
          "pm.test('Нет ответа 5xx (нет фатальной ошибки)', function () {",
          "    pm.expect(pm.response.code, 'HTTP-код').to.be.below(500);",
          "});",
          "",
          "pm.test('Тело — валидный JSON (или пустое)', function () {",
          "    var t = pm.response.text();",
          "    if (t && t.trim().length) {",
          "        var ok = true;",
          "        try { pm.response.json(); } catch (e) { ok = false; }",
          "        pm.expect(ok, 'ответ не является JSON: ' + t.slice(0, 300)).to.be.true;",
          "    }",
          "});",
          "",
          "pm.test('Нет утечки PHP-ошибки/исключения в теле', function () {",
          "    // Bitrix ловит необработанные исключения и отдаёт их как {status:error} с HTTP 200,",
          "    // поэтому проверяем именно текст тела на сигнатуры PHP-ошибок/исключений.",
          "    var t = pm.response.text() || '';",
          "    pm.expect(t).to.not.match(/Fatal error|Uncaught|Call to undefined|Stack trace|must be of type|Return value must be|Too few arguments|Argument #\\d|TypeError|<b>(Warning|Notice|Deprecated)<\\/b>/i);",
          "});"
        ]
      }
    }
  ],
