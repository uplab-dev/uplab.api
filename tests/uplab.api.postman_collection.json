          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Статус 200', () => pm.expect(pm.response.code).to.eql(200));",
            "const body = pm.response.json();",
            "pm.test('Ответ — массив свойств', () => pm.expect(body).to.be.an('array'));",
            "const data = Array.isArray(body) ? body : [];",
            "pm.test('У каждого свойства есть code, propertyType и непустой items', () => {",
            "  data.forEach(prop => {",
            "    pm.expect(prop).to.have.property('code');",
            "    pm.expect(prop).to.have.property('propertyType');",
            "    pm.expect(prop.items, 'items свойства ' + prop.code).to.be.an('array').that.is.not.empty;",
            "    prop.items.forEach(item => {",
            "      pm.expect(item).to.have.property('value');",
            "      pm.expect(item).to.have.property('text');",
            "    });",
            "  });",
            "});",
            "const listProps = data.filter(prop => prop.propertyType === 'L');",
            "(listProps.length ? pm.test : pm.test.skip)('Свойства типа «Список» (L) отдают значения: value — ID перечисления', () => {",
            "  listProps.forEach(prop => {",
            "    prop.items.forEach(item => pm.expect(Number(item.value), 'value значения свойства ' + prop.code).to.be.a('number').and.not.NaN);",
            "  });",
            "});",
            "const baseline = {};",
            "data.forEach(prop => { baseline[prop.code] = { propertyType: prop.propertyType, count: (prop.items || []).length, sampleValue: (prop.items || []).length ? prop.items[0].value : null }; });",
            "pm.collectionVariables.set('filterBaseline', JSON.stringify(baseline));"
          ] } }]
        },
        {
          "name": "Данные фильтра — сужение переданным filter",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"siteId\": \"{{siteId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/iblock/{{iblockCode}}/filter", "host": ["{{baseUrl}}"], "path": ["api", "iblock", "{{iblockCode}}", "filter"] }
