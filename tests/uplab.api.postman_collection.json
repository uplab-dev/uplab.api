            "url": { "raw": "{{baseUrl}}/api/sitemap", "host": ["{{baseUrl}}"], "path": ["api", "sitemap"] }
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Статус 200', () => pm.expect(pm.response.code).to.eql(200));"
          ] } }]
        }
      ]
    }
  ]
}
